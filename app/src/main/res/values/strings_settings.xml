    <string name="sandbox_usage_clear_title">Clear this chat’s workspace?</string>
    <string name="sandbox_usage_clear_body">Files in the workspace of “%1$s” will be deleted: attachments you sent, screens you shared and files tasks wrote. The chat itself stays, but those files in it won’t open any more.</string>
    <string name="sandbox_usage_clear_all">Clear all workspaces</string>
    <string name="sandbox_usage_clear_all_title">Clear every chat’s workspace?</string>
    <string name="sandbox_usage_clear_all_body">Files in every chat’s workspace will be deleted: attachments, shared screens and files tasks wrote. Chats stay. Chats with a running task are skipped.</string>
    <string name="sandbox_usage_note">The runtime and skills come with the app and aren’t cleared here; to start over, use “Reset environment” above.</string>
