    <string name="sandbox_proxy_off">%1$s · used once network access is on</string>
    <string name="net_proxy">Network proxy</string>
    <string name="net_proxy_row_sub">For model requests, updates, the in-app browser and commands</string>
    <string name="net_proxy_hint">Used for Mika’s model requests (chat, model lists, account sign-in), in-app update downloads, the in-app browser, and commands in Files &amp; computing environment while network access is on there. Addresses on this phone or your local network (localhost, 192.168.x.x, 10.x.x.x, names ending in .local) always connect directly, so local models keep working. It may include user:password@, stored encrypted on this phone. Leave empty for a direct connection.</string>
    <string name="net_proxy_invalid">Write it as http://host:port (socks5, socks5h and https work too), optionally with user:password@ before the host.</string>
    <string name="net_proxy_container_only">https:// proxies are only used by commands in Files &amp; computing environment; Mika’s own connections stay direct. Use http:// or socks5:// to cover everything.</string>
    <string name="net_proxy_browser_unsupported">This phone’s WebView can’t use a separate proxy, so the in-app browser connects directly.</string>
    <string name="net_proxy_browser_socks_auth">The in-app browser can’t use a SOCKS proxy that needs a user name and password, so it connects directly.</string>
    <string name="net_proxy_unreachable">Couldn’t reach the network proxy, or it didn’t pass the request on. Check that the proxy is running and that the address in Settings › Network proxy is right.</string>
    <string name="net_proxy_auth_failed">The network proxy rejected the user name or password. Check them in Settings › Network proxy.</string>
    <string name="sandbox_proxy_sub">Not set: commands connect directly. Change it in Settings › Network proxy</string>
    <string name="sandbox_proxy_on">%1$s · change it in Settings › Network proxy</string>
