    <string name="appaccess_risk_note">قد يؤدي التشغيل التلقائي إلى فرض قيود على الحساب لهذه التطبيقات؛ احظر ما لا تحتاج إليه.</string>
    <string name="appaccess_blocked">محظور</string>
    <string name="appaccess_allowed">مسموح</string>
